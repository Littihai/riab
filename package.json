{
  "name": "riab",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "A themeable UI starter: design tokens, dark mode, user-customizable appearance, th/en i18n",
  "license": "MIT",
  "author": "Littihai",
  "homepage": "https://littihai.github.io/riab/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Littihai/riab.git"
  },
  "bugs": {
    "url": "https://github.com/Littihai/riab/issues"
  },
  "keywords": [
    "react",
    "vite",
    "typescript",
    "starter",
    "template",
    "design-tokens",
    "dark-mode",
    "thai",
    "i18n",
    "accessibility"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:pages": "tsc -b && vite build --base=/riab/",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-thai": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.0.3",
    "vitest": "^2.1.9"
  }
}
