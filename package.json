{
  "name": "riab",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "A themeable UI starter: design tokens, dark mode, user-customizable appearance, th/en i18n",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:pages": "tsc -b && vite build --base=/riab/",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.3"
  }
}
